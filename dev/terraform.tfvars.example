aws_region   = "ap-southeast-2"
project_name = "tikto"

# Existing remote-state bucket in ap-southeast-2.
terraform_state_bucket_name = "tikto-terraform-state"
terraform_state_region      = "ap-southeast-2"

backend_image      = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/tikto/backend:sha-REPLACE"
notification_image = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/tikto/notification:sha-REPLACE"

frontend_bucket_name = "REPLACE-tikto-dev-frontend"
frontend_aliases     = []

# frontend_aliases             = ["dev.example.com"]
# frontend_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE"
# frontend_route53_zone_id     = "Z0123456789EXAMPLE"

backend_desired_count      = 1
notification_desired_count = 1
capacity_provider          = "FARGATE"

github_oidc_subjects = [
  "repo:tikto-calender@350233177/frontend@1440751116:environment:dev",
  "repo:tikto-calender@350233177/backend@1440751392:environment:dev",
