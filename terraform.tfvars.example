aws_region   = "ap-southeast-2"
project_name = "tikto"

network = {
  vpc_cidr             = "10.20.0.0/16"
  availability_zones   = ["ap-southeast-2a", "ap-southeast-2b", "ap-southeast-2c"]
  public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24", "10.20.2.0/24"]
}

map_public_ip_on_launch = true
log_retention_days      = 30

kubernetes_version = "1.36"

# Additional administrator roles. The cluster creator already has access.
eks_admin_role_arns = []

node_instance_types = ["t3.medium"]
node_capacity_type  = "ON_DEMAND"
node_min_size       = 3
node_desired_size   = 3
node_max_size       = 3

# Provision the Dev edge in the same apply as EKS.
enable_dev_edge          = true

# Provision the Prod edge in the same apply as EKS.
enable_edge = true

# Optional SNS topics for alarm notifications.
monitoring_alarm_actions = []
