aws_region       = "ap-southeast-1"
project_name     = "tikto"
keep_image_count = 30
nat_gateway_mode = "single"

# Must be the same bucket configured in backend.hcl.
terraform_state_bucket_name = "replace-with-tikto-terraform-state"

# Use the subject format shown in your GitHub repository OIDC settings.
# Repositories created after 2026-07-15 may use immutable owner/repository IDs.
github_build_oidc_subjects = [
  "repo:YOUR_ORG/YOUR_REPO:ref:refs/heads/main"
]

# The plan job uses the GitHub Environment named infrastructure-plan.
github_plan_oidc_subjects = [
  "repo:YOUR_ORG/YOUR_REPO:environment:infrastructure-plan"
]
