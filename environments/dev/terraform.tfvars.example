aws_region   = "ap-southeast-1"
project_name = "tikto"

# Must be the same bucket configured in backend.hcl.
terraform_state_bucket_name = "replace-with-tikto-terraform-state"

backend_image      = "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/tikto/backend:sha-REPLACE"
notification_image = "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/tikto/notification:sha-REPLACE"
backend_image_tag  = "sha-REPLACE"
app_version        = "1.1.0-dev"

frontend_bucket_name = "REPLACE-tikto-dev-frontend"
frontend_aliases     = []

# frontend_aliases             = ["dev.example.com"]
# frontend_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE"
# frontend_route53_zone_id     = "Z0123456789EXAMPLE"

backend_desired_count      = 1
notification_desired_count = 1
capacity_provider          = "FARGATE"

github_oidc_subjects = [
  "repo:YOUR_ORG/YOUR_REPO:environment:dev"
]
