aws_region       = "ap-southeast-2"
project_name     = "tikto"
keep_image_count = 30

# Existing remote-state bucket in ap-southeast-2.
terraform_state_bucket_name = "tikto-terraform-state"

# These repositories were created after 2026-07-15, so their OIDC subjects use
# immutable organization and repository IDs.
github_build_oidc_subjects = [
  "repo:tikto-calender@350233177/backend@1440751392:ref:refs/heads/dev",
  "repo:tikto-calender@350233177/backend@1440751392:ref:refs/heads/main",
  "repo:tikto-calender@350233177/backend@1440751392:environment:prod",
  "repo:tikto-calender@350233177/notification-service@1439596194:ref:refs/heads/dev",
  "repo:tikto-calender@350233177/notification-service@1439596194:ref:refs/heads/main",
  "repo:tikto-calender@350233177/notification-service@1439596194:environment:prod"
]

# The plan job uses the GitHub Environment named infrastructure-plan.
github_plan_oidc_subjects = [
  "repo:tikto-calender@350233177/infra@1440850563:environment:infrastructure-plan"
]
